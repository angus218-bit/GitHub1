{
  "name": "github1-taskboard",
  "version": "1.0.0",
  "description": "A minimal full-stack task board (Vite + React frontend, Express API) used to demonstrate the Cloud Agent development environment end to end.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "lint": "eslint .",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.14.0",
    "supertest": "^7.0.0",
    "vite": "^5.4.11"
  }
}
